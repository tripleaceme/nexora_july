# Nexora CareSync pipeline configuration
# Copy this file to .env and fill in your local values.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_health
DB_USER=nexora
DB_PASSWORD=change-me

# The connection string the ETL scripts actually use. Keep it in step with the
# five settings above: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://nexora:change-me@localhost:5432/nexora_health

# Directory the pipeline reads batches from by default
DATA_DIR=data/source
