# Nexora CareSync pipeline configuration
# Copy this file to .env and fill in your local values.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora_health
DB_USER=nexora
DB_PASSWORD=change-me

# Directory the pipeline reads batches from by default
DATA_DIR=data/source

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
